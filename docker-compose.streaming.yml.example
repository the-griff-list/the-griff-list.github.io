services:
  mediamtx:
    image: bluenviron/mediamtx:latest
    container_name: grifflist-mediamtx
    restart: unless-stopped
    volumes:
      - ./mediamtx.yml:/mediamtx.yml:ro
    expose:
      - "8889"
    ports:
      - "8189:8189/udp"
    networks:
      - streaming
  caddy:
    image: caddy:2
    container_name: grifflist-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - streaming
networks:
  streaming:
volumes:
  caddy_data:
  caddy_config:
